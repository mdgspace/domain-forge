// ==========================================
// METRIC COLLECTION & MIMIR REMOTE WRITE
// ==========================================

// Scrape cAdvisor for container telemetry
prometheus.scrape "cadvisor" {
  targets = [{
    __address__ = "cadvisor:8080",
  }]
  forward_to = [
    prometheus.relabel.filter_metrics_opbot_xd.receiver,
    prometheus.relabel.filter_metrics_MS_githubaccnt.receiver,
    prometheus.relabel.filter_metrics_alronova.receiver,
    prometheus.relabel.filter_metrics_LordRyuga.receiver,
    prometheus.relabel.filter_metrics_baync180705.receiver,
    prometheus.relabel.filter_metrics_Annonnymmousss.receiver,
    prometheus.relabel.filter_metrics_Weaver1209.receiver,
    prometheus.relabel.filter_metrics_error110_bit.receiver,
    prometheus.relabel.filter_metrics_admin.receiver,
  ]
  scrape_interval = "15s"
}

// Tenant metric ingestion pipeline for 'opbot-xd'
prometheus.relabel "filter_metrics_opbot_xd" {
  forward_to = [
    prometheus.remote_write.mimir_opbot_xd.receiver,
  ]

  rule {
    source_labels = ["__name__"]
    regex         = "container_(cpu_usage_seconds_total|memory_usage_bytes|memory_max_usage_bytes|network_.*_bytes_total|fs_usage_bytes|fs_limit_bytes)"
    action        = "keep"
  }

  rule {
    source_labels = ["name"]
    regex         = "^/?(.*)$"
    target_label  = "container_name"
  }

  rule {
    source_labels = ["container_name"]
    regex         = "(df_.*|docker[-_]df_.*|domain[-_]forge[-_].*|cadvisor.*|prometheus.*|mimir.*|loki.*|alloy.*|grafana.*|traefik.*|caddy.*)"
    action        = "drop"
  }

  rule {
    source_labels = ["container_label_df_author", "container_name"]
    regex         = "^opbot-xd;.*|.*;(cipoc\\.domains\\.pluto\\.mdgspace\\.org|idk\\.domains\\.pluto\\.mdgspace\\.org|weaver-test\\.domains\\.pluto\\.mdgspace\\.org)$"
    action        = "keep"
  }

  rule {
    source_labels = ["container_name"]
    target_label  = "subdomain"
  }
}

prometheus.remote_write "mimir_opbot_xd" {
  endpoint {
    url = "http://mimir:8080/api/v1/push"
    headers = {
      "X-Scope-OrgID" = "opbot-xd",
    }
  }
}

