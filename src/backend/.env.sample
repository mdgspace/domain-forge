GITHUB_OAUTH_CLIENT_ID=...
GITHUB_OAUTH_CLIENT_SECRET=...
GITLAB_OAUTH_CLIENT_ID=...
GITLAB_OAUTH_CLIENT_SECRET=...
MONGO_URI=mongodb://localhost:27017/domain-forge
SENTRY_DSN=...
FRONTEND=http://localhost:8000
BACKEND_URL=http://localhost:7000
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
ADMIN_LIST=admin1|admin2
SUPER_ADMIN_LIST=superadmin1|superadmin2
JWT_SECRET=your_jwt_secret_key
GRAFANA_JWT_SECRET=your_grafana_jwt_secret
GF_SECURITY_ADMIN_PASSWORD=your_grafana_admin_password
MEMORY_LIMIT=500m
ENCRYPTION_KEY=...

# Health Monitor Configuration
PROMETHEUS_URL=http://prometheus:9090
HEALTH_CHECK_INTERVAL=30000
HEALTH_DEBUG=false
MAX_CPU_THRESHOLD=90
MAX_MEMORY_THRESHOLD=85
MAX_RESTART_COUNT=5

# Log Cleanup Configuration (all optional — sensible defaults are built-in)
LOG_CLEANUP_INTERVAL_MS=86400000  # 24 hours (default)
MAX_LOG_SIZE_BYTES=512000         # 500KB (default)